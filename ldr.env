# Local Deep Research configuration: the source of truth, versioned with models.py.
#
# LDR_* variables override LDR's encrypted settings database on every read, so
# anything set here is read-only in the web UI: a UI change appears to save and is
# ignored. Pin here what should be reproducible; leave out what you tune live
# (strategy, iteration depth, engine mix). Details: docs/deep-research.md.
#
# Loaded by bin/ldr, which also sets LDR_DATA_DIR to <repo>/ldr-data.

LDR_LLM_PROVIDER=openai_endpoint
LDR_LLM_OPENAI_ENDPOINT_URL=http://127.0.0.1:9090/v1
LDR_LLM_OPENAI_ENDPOINT_API_KEY=dummy

# A llama-swap routing key, exactly as `lai ls` prints it. `lai check` warns if
# it stops naming an enabled model. Remove this line to choose per run in the UI.
LDR_LLM_MODEL=qwen38-27b-c1-mtp

LDR_SEARCH_TOOL=searxng
LDR_SEARCH_ENGINE_WEB_SEARXNG_DEFAULT_PARAMS_INSTANCE_URL=http://127.0.0.1:8888
